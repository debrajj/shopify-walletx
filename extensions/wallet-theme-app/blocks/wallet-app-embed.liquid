{% schema %}
{
  "name": "Wallet Coins",
  "target": "body",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable Wallet Widget",
      "default": true
    }
  ]
}
{% endschema %}

{% if block.settings.enabled %}
{% if customer %}
<!-- Wallet Widget v4.3 - Updated with increment/decrement buttons -->
<div id="wallet-app-embed" class="wallet-app-embed" data-shop="{{ shop.permanent_domain }}" data-customer-email="{{ customer.email }}" data-customer-phone="{{ customer.phone }}">
  <div class="wallet-embed-container">
    <button class="wallet-close-button" onclick="walletAppEmbed.hideWidget()" title="Close">×</button>
    <div class="wallet-embed-header">
      <svg class="wallet-icon" width="20" height="20" viewBox="0 0 20 20" fill="none">
        <path d="M17 6V5C17 3.89543 16.1046 3 15 3H5C3.89543 3 3 5V15C3 16.1046 3.89543 17 5 17H15C16.1046 17 17 16.1046 17 15V14M17 6H7C5.89543 6 5 6.89543 5 8V12C5 13.1046 5.89543 14 7 14H17M17 6V14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        <circle cx="13" cy="10" r="1" fill="currentColor"/>
      </svg>
      <span class="wallet-embed-title">Wallet</span>
    </div>
    
    <div id="wallet-embed-login" class="wallet-embed-login">
      <input 
        type="email" 
        id="wallet-embed-email" 
        placeholder="Email address"
        class="wallet-embed-input"
        autocomplete="email"
      />
      <button class="wallet-embed-button" data-wallet-action="check-balance">
        Check balance
      </button>
    </div>
    
    <div id="wallet-embed-display" class="wallet-embed-display" style="display: none;">
      <div class="wallet-balance-section">
        <div class="wallet-balance-label">Your balance</div>
        <div class="wallet-balance-amount" id="wallet-embed-balance-display">815 points</div>
      </div>
      <button class="wallet-redeem-button" data-wallet-action="show-redeem">
        Redeem points
      </button>
    </div>
    
    <div id="wallet-embed-redeem" class="wallet-embed-redeem" style="display: none;">
      <div class="wallet-coins-input-wrapper">
        <button class="wallet-coin-adjust-button" data-wallet-action="decrease-coins" title="Decrease coins">
          −
        </button>
        <input 
          type="number" 
          id="wallet-embed-coins-input" 
          placeholder="Enter coins to redeem (1 coin = ₹1)"
          class="wallet-embed-input wallet-coins-input"
          min="0"
        />
        <button class="wallet-coin-adjust-button" data-wallet-action="increase-coins" title="Increase coins">
          +
        </button>
        <button class="wallet-apply-arrow-button" data-wallet-action="apply-coins" title="Apply coins">
          →
        </button>
      </div>
      <p class="wallet-hint">Click arrow or press Enter to checkout with discount</p>
    </div>
    
    <div id="wallet-embed-message" class="wallet-embed-message"></div>
  </div>
</div>
{% else %}
<!-- Wallet widget hidden: Customer not logged in -->
{% endif %}
{% endif %}

<style>
  .wallet-app-embed {
    padding: 0;
    margin: 16px 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  }

  .wallet-embed-container {
    background: #ffffff;
    border: 1px solid #e3e3e3;
    border-radius: 8px;
    padding: 16px;
    position: relative;
  }

  .wallet-close-button {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 24px;
    height: 24px;
    padding: 0;
    background: #fff;
    color: #666;
    border: 1px solid #ddd;
    border-radius: 50%;
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
  }

  .wallet-close-button:hover {
    background: #f44336;
    color: white;
    border-color: #f44336;
  }

  .wallet-embed-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid #e3e3e3;
  }

  .wallet-icon {
    color: #202223;
    flex-shrink: 0;
  }

  .wallet-embed-title {
    font-size: 14px;
    font-weight: 600;
    color: #202223;
    letter-spacing: -0.01em;
  }

  .wallet-embed-display {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 4px 0;
  }

  .wallet-balance-section {
    flex: 1;
  }

  .wallet-balance-label {
    font-size: 14px;
    color: #999;
    margin-bottom: 4px;
    display: block;
  }

  .wallet-balance-amount {
    font-size: 28px;
    font-weight: 700;
    color: #333;
    display: block;
  }

  .wallet-redeem-button {
    padding: 12px 24px;
    background: white;
    color: #333;
    border: 1px solid #ddd;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
  }

  .wallet-redeem-button:hover {
    background: #fafafa;
    border-color: #ccc;
  }

  .wallet-embed-redeem {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .wallet-embed-login {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .wallet-embed-balance {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .wallet-balance-info {
    background: #f6f6f7;
    border-radius: 6px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .wallet-balance-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .wallet-label {
    font-size: 13px;
    color: #6d7175;
    font-weight: 400;
  }

  .wallet-value {
    font-size: 13px;
    color: #202223;
    font-weight: 600;
  }

  .wallet-value-large {
    font-size: 16px;
    color: #202223;
    font-weight: 600;
  }

  .wallet-hint {
    font-size: 12px;
    color: #666;
    margin: 0;
    text-align: center;
  }

  .wallet-coins-input-wrapper {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .wallet-coins-input {
    flex: 1;
    text-align: center;
  }

  .wallet-coin-adjust-button {
    width: 36px;
    height: 36px;
    padding: 0;
    background: #f0f0f0;
    color: #333;
    border: 1px solid #ddd;
    border-radius: 6px;
    font-size: 20px;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    user-select: none;
  }

  .wallet-coin-adjust-button:hover {
    background: #e0e0e0;
    border-color: #ccc;
  }

  .wallet-coin-adjust-button:active {
    background: #d0d0d0;
    transform: scale(0.95);
  }

  .wallet-apply-arrow-button {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    padding: 0;
    background: #667eea;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
    font-size: 20px;
    font-weight: bold;
  }

  .wallet-apply-arrow-button:hover {
    background: #5568d3;
    transform: translateX(2px);
  }

  .wallet-apply-arrow-button:active {
    background: #4557c2;
    transform: translateX(4px);
  }

  .wallet-apply-arrow-button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  .wallet-apply-arrow-button svg {
    flex-shrink: 0;
  }

  .wallet-new-total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px;
    background: #f6f6f7;
    border-radius: 6px;
  }

  .wallet-embed-input {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid #c9cccf;
    border-radius: 6px;
    font-size: 14px;
    background: #ffffff;
    color: #202223;
    box-sizing: border-box;
    transition: border-color 0.15s ease;
  }

  .wallet-embed-input::placeholder {
    color: #8c9196;
  }

  .wallet-embed-input:hover {
    border-color: #8c9196;
  }

  .wallet-embed-input:focus {
    outline: none;
    border-color: #005bd3;
    box-shadow: 0 0 0 1px #005bd3;
  }

  .wallet-embed-button {
    width: 100%;
    padding: 11px 16px;
    background: #ffffff;
    color: #202223;
    border: 1px solid #c9cccf;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
    text-align: center;
  }

  .wallet-embed-button:hover {
    background: #f6f6f7;
    border-color: #8c9196;
  }

  .wallet-embed-button:active {
    background: #e3e3e3;
  }

  .wallet-embed-button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .wallet-button-primary {
    background: #202223;
    color: #ffffff;
    border-color: #202223;
  }

  .wallet-button-primary:hover {
    background: #2c2e2f;
    border-color: #2c2e2f;
  }

  .wallet-button-primary:active {
    background: #44474a;
  }

  .wallet-embed-message {
    margin-top: 12px;
    padding: 10px 12px;
    border-radius: 6px;
    font-size: 13px;
    line-height: 1.4;
    display: none;
  }

  .wallet-embed-message.success {
    background: #d1f7c4;
    color: #0f5132;
    border: 1px solid #9dd084;
    display: block;
  }

  .wallet-embed-message.error {
    background: #fed3d1;
    color: #8a1f11;
    border: 1px solid #fea39e;
    display: block;
  }

  /* Hide the original embed element */
  .wallet-app-embed {
    display: none !important;
  }
  
  /* Always show the injected clone */
  #wallet-app-embed-injected {
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
    position: relative !important;
  }
</style>

<script>
(function() {
  const WIDGET_VERSION = '4.3.0'; // Version with increment/decrement buttons and auto-login
  console.log('[Wallet Widget] Version:', WIDGET_VERSION);
  
  if (window.walletAppEmbed) return; // Already initialized
  
  const API_BASE = 'https://shopify-walletx.onrender.com/api';
  const embedEl = document.getElementById('wallet-app-embed');
  if (!embedEl) return;
  
  const shop = embedEl.dataset.shop;
  const customerEmail = embedEl.dataset.customerEmail;
  const customerPhone = embedEl.dataset.customerPhone;
  
  window.walletAppEmbed = {
    currentEmail: customerEmail || '',
    currentBalance: 0,
    cartTotal: 0,
    coinValue: 1, // 1 coin = ₹1 (changed from 0.01)
    isCheckingBalance: false, // Flag to prevent duplicate checks
    hasAutoChecked: false, // Flag to prevent multiple auto-checks
    
    // Load saved email from localStorage or logged-in customer
    init: function() {
      // Auto-load balance if customer is logged in
      if (this.currentEmail) {
        console.log('[Wallet Widget] Customer logged in:', this.currentEmail);
        setTimeout(() => {
          this.checkBalance();
        }, 500);
      }
    },
    
    hideWidget: function() {
      const widget = document.getElementById('wallet-app-embed');
      if (widget) {
        widget.style.display = 'none';
      }
    },
          // Show balance immediately with saved data
          this.displayBalance(this.currentBalance);
          
          // Then refresh from server in background
          this.refreshBalance();
        }, 500);
      }
    },
    
    displayBalance: function(balance) {
      this.currentBalance = balance;
      
      const balanceEl = document.querySelector('#wallet-app-embed-injected #wallet-embed-balance-display');
      const displayContainer = document.querySelector('#wallet-app-embed-injected #wallet-embed-display');
      const loginContainer = document.querySelector('#wallet-app-embed-injected #wallet-embed-login');
      
      if (balanceEl) balanceEl.textContent = balance + ' points';
      if (displayContainer) displayContainer.style.display = 'flex';
      if (loginContainer) loginContainer.style.display = 'none';
      
      // Set up coin input listener
      const coinsInput = document.querySelector('#wallet-app-embed-injected #wallet-embed-coins-input');
      if (coinsInput) {
        // Update cart total
        this.updateCartDisplay();
        
        // Auto-limit input to max coins
        coinsInput.addEventListener('input', () => {
          const maxCoins = Math.min(this.currentBalance, Math.floor(this.cartTotal / this.coinValue));
          if (parseInt(coinsInput.value) > maxCoins) {
            coinsInput.value = maxCoins;
          }
        });
        
        // Apply coins on Enter key
        coinsInput.addEventListener('keypress', (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            this.applyCoins();
          }
        });
      }
    },
    
    showRedeemForm: function() {
      console.log('[Wallet Widget] showRedeemForm called');
      const displayContainer = document.querySelector('#wallet-app-embed-injected #wallet-embed-display');
      const redeemContainer = document.querySelector('#wallet-app-embed-injected #wallet-embed-redeem');
      const coinsInput = document.querySelector('#wallet-app-embed-injected #wallet-embed-coins-input');
      
      console.log('[Wallet Widget] Elements found:', {
        displayContainer: !!displayContainer,
        redeemContainer: !!redeemContainer,
        coinsInput: !!coinsInput
      });
      
      if (displayContainer) displayContainer.style.display = 'none';
      if (redeemContainer) redeemContainer.style.display = 'block';
      if (coinsInput) {
        coinsInput.value = ''; // Clear input
        coinsInput.focus();
      }
    },
    
    increaseCoins: function() {
      const coinsInput = document.querySelector('#wallet-app-embed-injected #wallet-embed-coins-input');
      if (!coinsInput) return;
      
      const currentValue = parseInt(coinsInput.value) || 0;
      const maxCoins = Math.min(this.currentBalance, Math.floor(this.cartTotal / this.coinValue));
      const newValue = Math.min(currentValue + 10, maxCoins); // Increase by 10
      
      coinsInput.value = newValue;
    },
    
    decreaseCoins: function() {
      const coinsInput = document.querySelector('#wallet-app-embed-injected #wallet-embed-coins-input');
      if (!coinsInput) return;
      
      const currentValue = parseInt(coinsInput.value) || 0;
      const newValue = Math.max(currentValue - 10, 0); // Decrease by 10, min 0
      
      coinsInput.value = newValue;
    },
    
    refreshBalance: async function() {
      if (!this.currentEmail) return;
      
      try {
        const response = await fetch(
          API_BASE + '/wallet/balance?email=' + encodeURIComponent(this.currentEmail),
          {
            headers: {
              'x-shop-url': shop,
            },
          }
        );

        const data = await response.json();

        if (data.success) {
          const newBalance = data.walletCoins || 0;
          if (newBalance !== this.currentBalance) {
            console.log('[Wallet Widget] Balance updated:', this.currentBalance, '->', newBalance);
            this.displayBalance(newBalance);
            localStorage.setItem('walletBalance', newBalance);
          }
        }
      } catch (err) {
        console.error('[Wallet Widget] Refresh error:', err);
      }
    },
    
    getCartTotal: function() {
      // Method 1: Try Shopify cart API (most reliable)
      return fetch('/cart.js')
        .then(res => res.json())
        .then(cart => {
          console.log('[Wallet Widget] Cart data:', cart);
          return cart.total_price / 100; // Convert cents to dollars
        })
        .catch(err => {
          console.error('[Wallet Widget] Cart fetch error:', err);
          // Fallback: try window.Shopify object
          if (window.Shopify && window.Shopify.cart) {
            return window.Shopify.cart.total_price / 100;
          }
          return 0;
        });
    },
    
    updateCartDisplay: async function() {
      this.cartTotal = await this.getCartTotal();
      
      const cartTotalEl = document.querySelector('#wallet-app-embed-injected #wallet-embed-cart-total');
      if (cartTotalEl) {
        cartTotalEl.textContent = '₹' + this.cartTotal.toFixed(2);
      }
      
      // Set max coins based on cart total
      const coinsInput = document.querySelector('#wallet-app-embed-injected #wallet-embed-coins-input');
      if (coinsInput) {
        const maxCoins = Math.min(this.currentBalance, Math.floor(this.cartTotal / this.coinValue));
        coinsInput.setAttribute('max', maxCoins);
        coinsInput.setAttribute('placeholder', `Max: ${maxCoins} coins`);
      }
      
      // Update savings display if coins are entered
      this.updateSavingsDisplay();
    },
    
    updateSavingsDisplay: function() {
      const coinsInput = document.querySelector('#wallet-app-embed-injected #wallet-embed-coins-input');
      const savingsDisplay = document.querySelector('#wallet-app-embed-injected #wallet-embed-savings');
      const savingsAmount = document.querySelector('#wallet-app-embed-injected #wallet-embed-savings-amount');
      const newTotalEl = document.querySelector('#wallet-app-embed-injected #wallet-embed-new-total');
      
      console.log('[Wallet Widget] updateSavingsDisplay called', {
        coinsInput: !!coinsInput,
        savingsDisplay: !!savingsDisplay,
        savingsAmount: !!savingsAmount,
        newTotalEl: !!newTotalEl
      });
      
      if (!coinsInput || !savingsDisplay || !savingsAmount || !newTotalEl) {
        console.warn('[Wallet Widget] Missing savings display elements');
        return;
      }
      
      const coinsToUse = parseInt(coinsInput.value) || 0;
      
      console.log('[Wallet Widget] Coins to use:', coinsToUse, 'Balance:', this.currentBalance, 'Cart:', this.cartTotal);
      
      if (coinsToUse > 0 && coinsToUse <= this.currentBalance) {
        const savings = coinsToUse * this.coinValue;
        const newTotal = Math.max(0, this.cartTotal - savings);
        
        console.log('[Wallet Widget] Showing savings:', savings, 'New total:', newTotal);
        
        savingsAmount.textContent = '₹' + savings.toFixed(2);
        newTotalEl.textContent = '₹' + newTotal.toFixed(2);
        savingsDisplay.style.display = 'flex';
        
        // Update the theme's cart total display
        this.updateThemeCartTotal(newTotal, savings);
      } else {
        console.log('[Wallet Widget] Hiding savings display');
        savingsDisplay.style.display = 'none';
        
        // Restore original cart total
        this.restoreThemeCartTotal();
      }
    },
    
    updateThemeCartTotal: function(newTotal, savings) {
      // Find common cart total selectors used by Shopify themes
      const totalSelectors = [
        '.cart-total-grandtotal .cart-total-value', // Ella theme specific
        '.cart-total-value', // Ella theme and similar
        '.cart__footer .totals__total-value',
        '.cart-footer__total',
        '[data-cart-total]',
        '.cart__total',
        '.cart-total',
        '.totals__total',
        '.cart-drawer__footer .totals__total-value',
        '.drawer__footer .totals__total-value',
        '#cart-total',
        '.js-contents .totals__total-value'
      ];
      
      let updated = false;
      
      for (const selector of totalSelectors) {
        const elements = document.querySelectorAll(selector);
        elements.forEach(el => {
          if (el && !el.hasAttribute('data-original-total')) {
            // Save original total
            el.setAttribute('data-original-total', el.textContent);
            
            // Update with new total - instant update
            const formattedTotal = 'Rs. ' + newTotal.toFixed(2);
            el.textContent = formattedTotal;
            
            // Add visual indicator with smooth transition
            el.style.transition = 'all 0.3s ease';
            el.style.color = '#10b981'; // Green color
            el.style.fontWeight = 'bold';
            
            console.log('[Wallet Widget] Updated cart total:', selector, formattedTotal);
            updated = true;
          } else if (el && el.hasAttribute('data-original-total')) {
            // Already modified, just update the value
            const formattedTotal = 'Rs. ' + newTotal.toFixed(2);
            el.textContent = formattedTotal;
            console.log('[Wallet Widget] Re-updated cart total:', selector, formattedTotal);
            updated = true;
          }
        });
      }
      
      if (!updated) {
        console.warn('[Wallet Widget] Could not find cart total element to update');
        console.log('[Wallet Widget] Tried selectors:', totalSelectors);
      }
    },
    
    restoreThemeCartTotal: function() {
      // Restore all modified cart totals
      const modifiedElements = document.querySelectorAll('[data-original-total]');
      
      modifiedElements.forEach(el => {
        const originalTotal = el.getAttribute('data-original-total');
        if (originalTotal) {
          el.textContent = originalTotal;
          el.removeAttribute('data-original-total');
          el.style.color = '';
          el.style.fontWeight = '';
          
          console.log('[Wallet Widget] Restored cart total:', originalTotal);
        }
      });
    },
    
    showMessage: function(text, type) {
      // Try to find message element in both original and injected widget
      let msgEl = document.getElementById('wallet-embed-message');
      if (!msgEl) {
        msgEl = document.querySelector('#wallet-app-embed-injected #wallet-embed-message');
      }
      if (!msgEl) {
        console.error('[Wallet Widget] Message element not found');
        return;
      }
      msgEl.textContent = text;
      msgEl.className = 'wallet-embed-message ' + type;
      msgEl.style.display = 'block';
      setTimeout(() => {
        msgEl.textContent = '';
        msgEl.className = 'wallet-embed-message';
        msgEl.style.display = 'none';
      }, 4000);
    },
    
    checkBalance: async function() {
      // Prevent duplicate calls
      if (this.isCheckingBalance) {
        console.log('[Wallet Widget] Already checking balance, skipping duplicate call');
        return;
      }
      
      this.isCheckingBalance = true;
      
      try {
        // Try to find email input in both original and injected widget
        let emailEl = document.getElementById('wallet-embed-email');
        if (!emailEl) {
          emailEl = document.querySelector('#wallet-app-embed-injected #wallet-embed-email');
        }
        if (!emailEl) {
          console.error('[Wallet Widget] Email input not found');
          return;
        }
        
        const email = emailEl.value.trim();
        if (!email) {
          this.showMessage('Please enter your email', 'error');
          return;
        }

        // Basic email validation
        if (!email.includes('@')) {
          this.showMessage('Please enter a valid email', 'error');
          return;
        }

        const response = await fetch(
          API_BASE + '/wallet/balance?email=' + encodeURIComponent(email),
          {
            headers: {
              'x-shop-url': shop,
            },
          }
        );

        const data = await response.json();

        if (data.success) {
          this.currentEmail = email;
          this.currentBalance = data.walletCoins || 0;
          
          // Save to localStorage for faster loading next time
          localStorage.setItem('walletEmail', email);
          localStorage.setItem('walletBalance', this.currentBalance);
          
          if (this.currentBalance > 0) {
            this.displayBalance(this.currentBalance);
            this.showMessage('Balance loaded!', 'success');
            console.log('[Wallet Widget] Balance loaded:', this.currentBalance, 'coins');
          } else {
            // No coins available
            this.showMessage('No coins available for this email', 'error');
            console.log('[Wallet Widget] No coins found for:', email);
          }
        } else {
          this.showMessage('Email not found. Please check your email or phone number.', 'error');
        }
      } catch (err) {
        console.error('[Wallet Widget] Error:', err);
        this.showMessage('Network error', 'error');
      } finally {
        // Reset flag after a short delay to allow legitimate subsequent calls
        setTimeout(() => {
          this.isCheckingBalance = false;
        }, 1000);
      }
    },
    
    applyCoins: async function() {
      const coinsInput = document.querySelector('#wallet-app-embed-injected #wallet-embed-coins-input');
      if (!coinsInput) {
        console.error('[Wallet Widget] ❌ Coins input not found');
        this.showMessage('Error: Input not found', 'error');
        return;
      }
      
      const coinsToUse = parseInt(coinsInput.value) || 0;
      
      console.log('[Wallet Widget] 📝 Apply coins request:', {
        coinsToUse,
        currentBalance: this.currentBalance,
        cartTotal: this.cartTotal,
        email: this.currentEmail
      });
      
      if (coinsToUse <= 0) {
        this.showMessage('Please enter coins to use', 'error');
        return;
      }
      
      if (coinsToUse > this.currentBalance) {
        this.showMessage('Not enough coins', 'error');
        return;
      }
      
      const maxCoins = Math.floor(this.cartTotal / this.coinValue);
      if (coinsToUse > maxCoins) {
        this.showMessage('Coins exceed cart total', 'error');
        return;
      }
      
      try {
        // Show loading message
        this.showMessage('Creating discount...', 'success');
        
        // Calculate discount amount
        const discountAmount = coinsToUse * this.coinValue;
        console.log('[Wallet Widget] 🎫 Creating discount for', coinsToUse, 'coins (₹' + discountAmount + ')');
        
        // Generate unique random discount code with COIN prefix
        const timestamp = Date.now().toString().slice(-6);
        const randomNum = Math.floor(Math.random() * 10000).toString().padStart(4, '0');
        const discountCode = `COIN${timestamp}${randomNum}`.toUpperCase();
        
        console.log('[Wallet Widget] 🎟️  Generated code:', discountCode, 'for ₹' + discountAmount);
        
        // Send request to backend to create discount and deduct coins
        const requestBody = {
          email: this.currentEmail,
          coinsToRedeem: coinsToUse,
          discountAmount: discountAmount,
          discountCode: discountCode,
        };
        
        console.log('[Wallet Widget] 📤 Creating discount in Shopify...');
        
        const response = await fetch(API_BASE + '/shopify/create-discount', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'x-shop-url': shop,
          },
          body: JSON.stringify(requestBody),
        });
        
        console.log('[Wallet Widget] 📥 Response status:', response.status);
        
        const data = await response.json();
        console.log('[Wallet Widget] 📥 Response data:', data);
        
        if (data.success) {
          console.log('[Wallet Widget] ✅ Discount created:', data.discountCode || discountCode);
          
          // Update balance
          if (data.newBalance !== undefined) {
            this.currentBalance = data.newBalance;
            localStorage.setItem('walletBalance', this.currentBalance);
            this.displayBalance(this.currentBalance);
          }
          
          const finalCode = data.discountCode || discountCode;
          
          if (data.isAutomatic) {
            // Automatic discount - no code needed, just go to checkout
            this.showMessage(`₹${discountAmount} discount will apply automatically! Redirecting...`, 'success');
            setTimeout(() => {
              console.log('[Wallet Widget] 🚀 Redirecting to checkout (automatic discount)');
              window.location.href = '/checkout';
            }, 1500);
          } else if (data.isExisting) {
            // Customer already has an active automatic discount
            this.showMessage(`Your ₹${discountAmount} discount will apply automatically! Redirecting...`, 'success');
            setTimeout(() => {
              console.log('[Wallet Widget] 🚀 Redirecting to checkout with existing automatic discount');
              window.location.href = '/checkout';
            }, 1500);
          } else if (data.requiresManualSetup) {
            this.showMessage(`Code ${finalCode} created! Please create this discount in Shopify admin for ₹${discountAmount}. Redirecting...`, 'success');
            console.log('[Wallet Widget] ⚠️  Manual setup required - create discount in Shopify admin');
            console.log('[Wallet Widget] Code:', finalCode, '| Amount: ₹' + discountAmount);
            setTimeout(() => {
              window.location.href = '/checkout?discount=' + encodeURIComponent(finalCode);
            }, 3000);
          } else {
            // Discount created successfully - apply code automatically
            this.showMessage(`₹${discountAmount} discount applied! Redirecting...`, 'success');
            setTimeout(() => {
              console.log('[Wallet Widget] 🚀 Redirecting to checkout with code:', finalCode);
              // Apply discount code automatically via URL
              window.location.href = '/checkout?discount=' + encodeURIComponent(finalCode);
            }, 1500);
          }
          
        } else {
          const errorMsg = data.error || data.message || 'Failed to apply coins';
          console.error('[Wallet Widget] ❌ Error:', errorMsg);
          this.showMessage(errorMsg, 'error');
        }
      } catch (err) {
        console.error('[Wallet Widget] ❌ Network error:', err);
        this.showMessage('Network error. Please try again.', 'error');
      }
    }
  };
  
  // Inject widget into cart drawer - works with any theme
  function injectIntoCartDrawer() {
    // Check if already injected
    if (document.querySelector('#wallet-app-embed-injected')) {
      console.log('[Wallet Widget] Already injected, skipping');
      return true;
    }
    
    // Try cart-discount first (preferred location)
    const discountElement = document.querySelector('.cart-discount');
    if (discountElement) {
      const clone = embedEl.cloneNode(true);
      clone.id = 'wallet-app-embed-injected';
      clone.style.display = 'block';
      clone.style.visibility = 'visible';
      clone.style.opacity = '1';
      
      if (discountElement.nextSibling) {
        discountElement.parentNode.insertBefore(clone, discountElement.nextSibling);
      } else {
        discountElement.parentNode.appendChild(clone);
      }
      
      console.log('[Wallet Widget] Injected after .cart-discount');
      attachButtonHandler(clone);
      walletAppEmbed.init(); // Auto-detect logged-in customer
      return true;
    }
    
    // Fallback: find any cart drawer/container
    const cartSelectors = [
      '.cart__footer',
      '.cart-footer',
      '[data-cart-footer]',
      'cart-drawer',
      '[data-cart-drawer]',
      '.cart-drawer',
      '#cart-drawer',
      '.drawer--cart'
    ];
    
    for (const selector of cartSelectors) {
      const container = document.querySelector(selector);
      if (container) {
        const clone = embedEl.cloneNode(true);
        clone.id = 'wallet-app-embed-injected';
        clone.style.display = 'block';
        clone.style.visibility = 'visible';
        clone.style.opacity = '1';
        
        // Insert at the beginning of cart footer/drawer
        if (container.firstChild) {
          container.insertBefore(clone, container.firstChild);
        } else {
          container.appendChild(clone);
        }
        
        console.log('[Wallet Widget] Injected into:', selector);
        attachButtonHandler(clone);
        walletAppEmbed.init(); // Auto-detect logged-in customer
        return true;
      }
    }
    
    console.log('[Wallet Widget] No cart container found');
    return false;
  }
  
  // Attach handlers to the cloned widget
  function attachButtonHandler(clonedWidget) {
    const checkButton = clonedWidget.querySelector('[data-wallet-action="check-balance"]');
    if (checkButton) {
      checkButton.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        console.log('[Wallet Widget] Check balance clicked');
        walletAppEmbed.checkBalance();
      });
      console.log('[Wallet Widget] Check balance handler attached');
    }
    
    // Attach redeem button handler
    const redeemButton = clonedWidget.querySelector('[data-wallet-action="show-redeem"]');
    console.log('[Wallet Widget] Looking for redeem button:', !!redeemButton);
    if (redeemButton) {
      redeemButton.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        console.log('[Wallet Widget] Redeem points clicked');
        walletAppEmbed.showRedeemForm();
      });
      console.log('[Wallet Widget] Redeem button handler attached');
    } else {
      console.warn('[Wallet Widget] Redeem button not found in cloned widget');
    }
    
    // Attach increase coins button handler
    const increaseButton = clonedWidget.querySelector('[data-wallet-action="increase-coins"]');
    if (increaseButton) {
      increaseButton.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        walletAppEmbed.increaseCoins();
      });
      console.log('[Wallet Widget] Increase button handler attached');
    }
    
    // Attach decrease coins button handler
    const decreaseButton = clonedWidget.querySelector('[data-wallet-action="decrease-coins"]');
    if (decreaseButton) {
      decreaseButton.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        walletAppEmbed.decreaseCoins();
      });
      console.log('[Wallet Widget] Decrease button handler attached');
    }
    
    // Attach arrow button handler
    const applyButton = clonedWidget.querySelector('[data-wallet-action="apply-coins"]');
    if (applyButton) {
      applyButton.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        console.log('[Wallet Widget] 🎯 Arrow button clicked');
        walletAppEmbed.applyCoins();
      });
      console.log('[Wallet Widget] Apply arrow button handler attached');
    }
    
    // Add email input listeners for instant check
    const emailInput = clonedWidget.querySelector('#wallet-embed-email');
    if (emailInput) {
      // Check on Enter key
      emailInput.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          walletAppEmbed.checkBalance();
        }
      });
      
      // Auto-check on blur (when user clicks away)
      emailInput.addEventListener('blur', function() {
        const email = emailInput.value.trim();
        if (email && email.includes('@')) {
          console.log('[Wallet Widget] Auto-checking balance on blur');
          walletAppEmbed.checkBalance();
        }
      });
      
      console.log('[Wallet Widget] Email input listeners attached');
    }
  }
  
  // Try injection on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      console.log('[Wallet Widget] DOM loaded, trying injection...');
      injectIntoCartDrawer();
    });
  } else {
    console.log('[Wallet Widget] Document ready, trying injection...');
    injectIntoCartDrawer();
  }
  
  // Also try when cart opens or updates
  document.addEventListener('cart:open', function() {
    console.log('[Wallet Widget] Cart opened');
    setTimeout(injectIntoCartDrawer, 100);
  });
  
  document.addEventListener('cart:updated', function() {
    console.log('[Wallet Widget] Cart updated');
    setTimeout(injectIntoCartDrawer, 100);
    // Update cart total if widget is visible
    if (window.walletAppEmbed && window.walletAppEmbed.currentEmail) {
      setTimeout(() => window.walletAppEmbed.updateCartDisplay(), 200);
    }
  });
  
  // Listen for Shopify cart changes
  if (window.Shopify && window.Shopify.onCartUpdate) {
    const originalOnCartUpdate = window.Shopify.onCartUpdate;
    window.Shopify.onCartUpdate = function(cart) {
      if (originalOnCartUpdate) originalOnCartUpdate(cart);
      if (window.walletAppEmbed && window.walletAppEmbed.currentEmail) {
        window.walletAppEmbed.updateCartDisplay();
      }
    };
  }
  
  // Watch for DOM changes (for dynamically loaded carts)
  const observer = new MutationObserver(function(mutations) {
    mutations.forEach(function(mutation) {
      if (mutation.addedNodes.length) {
        mutation.addedNodes.forEach(function(node) {
          if (node.nodeType === 1) {
            // Check if cart-related element was added
            if (node.classList && (
              node.classList.contains('cart-drawer') ||
              node.classList.contains('cart-discount') ||
              node.id === 'cart-drawer' ||
              node.id === 'cart'
            )) {
              console.log('[Wallet Widget] Cart element detected, injecting...');
              setTimeout(injectIntoCartDrawer, 100);
            } else if (node.querySelector) {
              const hasCart = node.querySelector('.cart-drawer, .cart-discount, #cart-drawer, #cart');
              if (hasCart) {
                console.log('[Wallet Widget] Cart element found in subtree, injecting...');
                setTimeout(injectIntoCartDrawer, 100);
              }
            }
          }
        });
      }
    });
  });
  
  // Start observing
  observer.observe(document.body, {
    childList: true,
    subtree: true
  });
  
  // Initialize (check for saved session)
  walletAppEmbed.init();
  
  // Use event delegation for button clicks (backup method)
  document.addEventListener('click', function(e) {
    const target = e.target;
    // Check if clicked element or any parent has the data attribute
    let element = target;
    while (element && element !== document) {
      if (element.hasAttribute && element.hasAttribute('data-wallet-action')) {
        const action = element.getAttribute('data-wallet-action');
        e.preventDefault();
        e.stopPropagation();
        
        console.log('[Wallet Widget] Event delegation caught action:', action);
        
        if (action === 'check-balance') {
          console.log('[Wallet Widget] Check balance (delegation)');
          walletAppEmbed.checkBalance();
          return;
        } else if (action === 'show-redeem') {
          console.log('[Wallet Widget] Show redeem form (delegation)');
          walletAppEmbed.showRedeemForm();
          return;
        } else if (action === 'apply-coins') {
          console.log('[Wallet Widget] Apply coins (delegation)');
          walletAppEmbed.applyCoins();
          return;
        } else if (action === 'increase-coins') {
          console.log('[Wallet Widget] Increase coins (delegation)');
          walletAppEmbed.increaseCoins();
          return;
        } else if (action === 'decrease-coins') {
          console.log('[Wallet Widget] Decrease coins (delegation)');
          walletAppEmbed.decreaseCoins();
          return;
        }
      }
      element = element.parentElement;
    }
  }, true); // Use capture phase
  
  // Auto-check balance for logged-in customers
  function autoCheckBalance() {
    // Prevent multiple auto-checks
    if (walletAppEmbed.hasAutoChecked) {
      console.log('[Wallet Widget] Already auto-checked, skipping');
      return;
    }
    
    {% if customer %}
      const customerEmail = {{ customer.email | json }};
      console.log('[Wallet Widget] Auto-checking balance for logged-in customer:', customerEmail);
      
      // Mark as checked
      walletAppEmbed.hasAutoChecked = true;
      
      // Try multiple times with increasing delays to ensure widget is injected
      let attempts = 0;
      const maxAttempts = 5;
      
      function tryAutoCheck() {
        attempts++;
        console.log('[Wallet Widget] Auto-check attempt', attempts);
        
        const emailInput = document.querySelector('#wallet-app-embed-injected #wallet-embed-email');
        
        if (emailInput && customerEmail) {
          console.log('[Wallet Widget] Found email input, filling and checking balance');
          emailInput.value = customerEmail;
          // Trigger balance check automatically
          walletAppEmbed.checkBalance();
        } else if (attempts < maxAttempts) {
          console.log('[Wallet Widget] Widget not ready, retrying in 300ms...');
          setTimeout(tryAutoCheck, 300);
        } else {
          console.log('[Wallet Widget] Failed to find widget after', maxAttempts, 'attempts');
          // Reset flag if we failed, so it can try again later
          walletAppEmbed.hasAutoChecked = false;
        }
      }
      
      // Start trying after initial delay
      setTimeout(tryAutoCheck, 400);
    {% else %}
      console.log('[Wallet Widget] No customer logged in, manual email entry required');
    {% endif %}
  }
  
  // Run auto-check after injection attempts
  setTimeout(autoCheckBalance, 100);
  
  // Also run when cart opens
  document.addEventListener('cart:open', function() {
    console.log('[Wallet Widget] Cart opened, triggering auto-check');
    setTimeout(autoCheckBalance, 100);
  });
  
  console.log('[Wallet Widget] Initialized and watching for cart');
})();
</script>
{% endif %}
