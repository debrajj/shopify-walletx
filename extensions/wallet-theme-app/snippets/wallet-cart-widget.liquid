{% if customer %}
<div id="wallet-cart-widget" class="wallet-cart-widget" data-shop="{{ shop.permanent_domain }}" data-customer-email="{{ customer.email }}" data-customer-phone="{{ customer.phone }}">
  <div class="wallet-cart-container">
    <div id="wallet-cart-display" class="wallet-cart-display" style="display: none;">
      <div class="wallet-balance-section">
        <div class="wallet-balance-label">Your balance</div>
        <div class="wallet-balance-amount" id="wallet-balance-display">0 points</div>
      </div>
      <button class="wallet-redeem-button" onclick="walletCartWidget.showRedeemForm()">
        Redeem points
      </button>
    </div>
    
    <div id="wallet-cart-redeem" class="wallet-cart-redeem" style="display: none;">
      <div class="wallet-input-wrapper">
        <input 
          type="number" 
          id="wallet-coins-input" 
          placeholder="Enter coins to redeem (1 coin = ₹1)"
          class="wallet-cart-input"
          min="1"
        />
        <button class="wallet-cart-arrow" onclick="walletCartWidget.applyCoins()" title="Click arrow or press Enter to checkout with discount">
          →
        </button>
      </div>
      <div class="wallet-input-hint">Click arrow or press Enter to checkout with discount</div>
    </div>
    
    <div id="wallet-cart-login" class="wallet-cart-login">
      <input 
        type="tel" 
        id="wallet-phone" 
        placeholder="Phone number"
        class="wallet-cart-input"
      />
      <button class="wallet-cart-button-small" onclick="walletCartWidget.checkBalance()">
        Check Balance
      </button>
    </div>
    
    <div id="wallet-cart-message" class="wallet-cart-message"></div>
  </div>
</div>
{% else %}
<!-- Wallet widget hidden: Customer not logged in -->
{% endif %}

<style>
  .wallet-cart-widget {
    padding: 16px;
    margin: 12px 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .wallet-cart-container {
    background: #f5f5f5;
    border-radius: 12px;
    padding: 20px;
  }

  .wallet-cart-display {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .wallet-balance-section {
    flex: 1;
  }

  .wallet-balance-label {
    font-size: 14px;
    color: #999;
    margin-bottom: 4px;
    display: block;
  }

  .wallet-balance-amount {
    font-size: 28px;
    font-weight: 700;
    color: #333;
    display: block;
  }

  .wallet-redeem-button {
    padding: 12px 24px;
    background: white;
    color: #333;
    border: 1px solid #ddd;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
  }

  .wallet-redeem-button:hover {
    background: #fafafa;
    border-color: #ccc;
  }

  .wallet-cart-redeem {
    margin-top: 12px;
  }

  .wallet-input-wrapper {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-bottom: 8px;
  }

  .wallet-cart-input {
    flex: 1;
    padding: 10px 12px;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    font-size: 14px;
    background: white;
    color: #333;
    box-sizing: border-box;
  }

  .wallet-cart-input::placeholder {
    color: #999;
  }

  .wallet-cart-input:focus {
    outline: none;
    border-color: #667eea;
  }

  .wallet-cart-arrow {
    width: 40px;
    height: 40px;
    padding: 0;
    background: #667eea;
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 20px;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .wallet-cart-arrow:hover {
    background: #5568d3;
    transform: translateX(2px);
  }

  .wallet-cart-arrow:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .wallet-input-hint {
    font-size: 12px;
    color: #666;
    text-align: center;
  }

  .wallet-cart-button-small {
    width: 100%;
    padding: 10px;
    background: #667eea;
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
  }

  .wallet-cart-button-small:hover {
    background: #5568d3;
  }

  .wallet-cart-message {
    margin-top: 8px;
    padding: 8px;
    border-radius: 6px;
    font-size: 12px;
    text-align: center;
  }

  .wallet-cart-message.success {
    background: #e8f5e9;
    color: #2e7d32;
    border: 1px solid #a5d6a7;
  }

  .wallet-cart-message.error {
    background: #ffebee;
    color: #c62828;
    border: 1px solid #ef9a9a;
  }
</style>

<script>
(function() {
  if (window.walletCartWidget) return; // Already initialized
  
  const API_BASE = 'https://shopify-walletx.onrender.com/api';
  const widgetEl = document.getElementById('wallet-cart-widget');
  if (!widgetEl) return;
  
  const shop = widgetEl.dataset.shop;
  const customerEmail = widgetEl.dataset.customerEmail;
  const customerPhone = widgetEl.dataset.customerPhone;
  
  window.walletCartWidget = {
    currentPhone: customerPhone || '',
    currentEmail: customerEmail || '',
    currentBalance: 0,
    
    init: function() {
      // Auto-load balance if customer is logged in
      if (this.currentEmail || this.currentPhone) {
        this.loadBalance();
      }
    },
    
    loadBalance: async function() {
      try {
        const identifier = this.currentEmail || this.currentPhone;
        const response = await fetch(
          API_BASE + '/wallet/balance?phone=' + encodeURIComponent(identifier),
          {
            headers: {
              'x-shop-url': shop,
            },
          }
        );

        const data = await response.json();

        if (data.success) {
          this.currentBalance = data.walletCoins || 0;
          
          document.getElementById('wallet-balance-display').textContent = this.currentBalance + ' points';
          
          if (this.currentBalance > 0) {
            document.getElementById('wallet-cart-display').style.display = 'flex';
            document.getElementById('wallet-cart-login').style.display = 'none';
            document.getElementById('wallet-coins-input').max = this.currentBalance;
          } else {
            // Hide widget if no balance
            document.getElementById('wallet-cart-widget').style.display = 'none';
          }
        }
      } catch (err) {
        console.error('Failed to load wallet balance:', err);
        // Hide widget on error
        document.getElementById('wallet-cart-widget').style.display = 'none';
      }
    },
    
    showMessage: function(text, type) {
      const msgEl = document.getElementById('wallet-cart-message');
      msgEl.textContent = text;
      msgEl.className = 'wallet-cart-message ' + type;
      setTimeout(() => {
        msgEl.textContent = '';
        msgEl.className = 'wallet-cart-message';
      }, 4000);
    },

    showRedeemForm: function() {
      document.getElementById('wallet-cart-display').style.display = 'none';
      document.getElementById('wallet-cart-redeem').style.display = 'block';
      document.getElementById('wallet-coins-input').focus();
    },

    checkBalance: async function() {
      const phone = document.getElementById('wallet-phone').value.trim();
      if (!phone) {
        this.showMessage('Please enter phone number', 'error');
        return;
      }

      try {
        const response = await fetch(
          API_BASE + '/wallet/balance?phone=' + encodeURIComponent(phone),
          {
            headers: {
              'x-shop-url': shop,
            },
          }
        );

        const data = await response.json();

        if (data.success) {
          this.currentPhone = phone;
          this.currentBalance = data.walletCoins || 0;
          
          document.getElementById('wallet-balance-display').textContent = this.currentBalance + ' points';
          
          if (this.currentBalance > 0) {
            document.getElementById('wallet-cart-display').style.display = 'flex';
            document.getElementById('wallet-cart-login').style.display = 'none';
            document.getElementById('wallet-coins-input').max = this.currentBalance;
            this.showMessage('Balance loaded!', 'success');
          } else {
            this.showMessage('No coins available', 'error');
          }
        } else {
          this.showMessage('Phone not found', 'error');
        }
      } catch (err) {
        this.showMessage('Network error', 'error');
      }
    },
    
    applyCoins: function() {
      const coins = parseFloat(document.getElementById('wallet-coins-input').value);

      if (!coins || coins <= 0) {
        this.showMessage('Enter valid amount', 'error');
        return;
      }

      if (coins > this.currentBalance) {
        this.showMessage('Only ' + this.currentBalance + ' coins available', 'error');
        return;
      }

      const phoneDigits = this.currentPhone.replace(/\D/g, '');
      const discountCode = 'COIN-' + phoneDigits + '-' + coins;

      this.showMessage('Redirecting to checkout...', 'success');
      
      setTimeout(() => {
        window.location.href = '/discount/' + discountCode + '?redirect=/checkout';
      }, 800);
    }
  };

  // Initialize on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => walletCartWidget.init());
  } else {
    walletCartWidget.init();
  }

  // Add Enter key support for input
  document.addEventListener('DOMContentLoaded', function() {
    const coinsInput = document.getElementById('wallet-coins-input');
    if (coinsInput) {
      coinsInput.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
          walletCartWidget.applyCoins();
        }
      });
    }
  });
})();
</script>
